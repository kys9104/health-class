# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL of the deployed application
APP_URL="https://my-health-fitness-app.vercel.app"

# Optional Firebase Client Environment Variables (Can also be set in Teacher Dashboard UI)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional Google Apps Script (GAS) Webhook URL (Can also be set in Teacher Dashboard UI)
VITE_GAS_WEBHOOK_URL=""
