rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Health check & connection test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Workout logs
    match /workoutLogs/{logId} {
      allow read: if true;
      allow create, update, delete: if isValidId(logId);
    }

    // InBody records
    match /inbodyRecords/{recordId} {
      allow read: if true;
      allow create, update, delete: if isValidId(recordId);
    }

    // Workout plans
    match /workoutPlans/{studentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(studentId);
    }

    // Students roster
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(studentId);
    }

    // App config
    match /config/{configId} {
      allow read, write: if true;
    }

    // Default deny for unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
